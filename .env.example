# El agente también acepta estas variables desde el entorno del proceso.
OPENROUTER_API_KEY=sk-or-v1-...
PERPLEXITY_API_KEY=pplx-...

# Opcionales
TOOLS_WORKSHOP_MODEL=deepseek-flash
TOOLS_WORKSHOP_PORT=4317
TOOLS_WORKSHOP_DATA_DIR=./data
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:4317
OPENROUTER_X_TITLE=CloudX Skills Workshop

# Modelos válidos: deepseek-flash (default) o claude-sonnet.
# Conveniencia local: si falta una variable, config.js también la busca en
# ../broker-agent/.env. Podés desactivar el fallback con un path inexistente.
# TOOLS_WORKSHOP_SEED_ENV=/ruta/a/otro/.env
